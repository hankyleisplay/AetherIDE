<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="程式IDE.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:程式IDE"
    xmlns:models="using:程式IDE.Models"
    xmlns:services="using:程式IDE.Services"
    xmlns:vm="using:程式IDE.ViewModels"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AetherIDE">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" /> <!-- Custom Title Bar -->
            <RowDefinition Height="Auto" /> <!-- Menu Bar -->
            <RowDefinition Height="*" />    <!-- Main Workspace -->
            <RowDefinition Height="28" />   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0" Spacing="10">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Width="26" Height="26" CornerRadius="6">
                    <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AetherIDE" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                <Border Width="1" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />
                <TextBlock Text="{x:Bind ViewModel.WorkspaceName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center Search / Command Bar -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <AutoSuggestBox x:Name="TitleSearchBox"
                                PlaceholderText="搜尋檔案、命令或向 Aether AI 發問 (Ctrl+P)"
                                QueryIcon="Find"
                                VerticalAlignment="Center"
                                QuerySubmitted="TitleSearchBox_QuerySubmitted" />
            </Grid>

            <!-- Right Quick Action Bar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,140,0" Spacing="4">
                <!-- Run Button -->
                <Button x:Name="BtnQuickRun"
                        ToolTipService.ToolTip="執行目前檔案 (F5)"
                        Click="BtnQuickRun_Click"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Padding="8,5"
                        CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" />
                        <TextBlock Text="執行" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>

                <!-- Stop Button (Visible when running) -->
                <Button x:Name="BtnQuickStop"
                        ToolTipService.ToolTip="終止執行 (Shift+F5)"
                        Click="BtnQuickStop_Click"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsProcessRunning), Mode=OneWay}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        Padding="8,5"
                        CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="White" />
                        <TextBlock Text="停止" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>

                <!-- Format Code Button -->
                <Button ToolTipService.ToolTip="格式化程式碼 (Shift+Alt+F)" Click="MenuFormatDocument_Click" Padding="7,5" CornerRadius="4">
                    <FontIcon Glyph="&#xE790;" FontSize="13" />
                </Button>

                <!-- Save Button -->
                <Button ToolTipService.ToolTip="儲存 (Ctrl+S)" Click="BtnSave_Click" Padding="7,5" CornerRadius="4">
                    <FontIcon Glyph="&#xE74E;" FontSize="13" />
                </Button>

                <!-- Theme Toggle Button -->
                <Button ToolTipService.ToolTip="切換深色/淺色主題" Click="BtnThemeToggle_Click" Padding="7,5" CornerRadius="4">
                    <FontIcon Glyph="&#xE708;" FontSize="13" />
                </Button>

                <!-- Toggle Sidebar Button -->
                <Button ToolTipService.ToolTip="切換側邊欄" Click="BtnToggleSidebar_Click" Padding="7,5" CornerRadius="4">
                    <FontIcon Glyph="&#xE8A0;" FontSize="13" />
                </Button>

                <!-- Toggle Terminal Button -->
                <Button ToolTipService.ToolTip="切換下方面板 (Ctrl+`)" Click="BtnToggleBottomPanel_Click" Padding="7,5" CornerRadius="4">
                    <FontIcon Glyph="&#xE756;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Menu Bar -->
        <MenuBar Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <MenuBarItem Title="檔案(F)">
                <MenuFlyoutItem Text="新增檔案" Icon="Add" Click="MenuNewFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem Text="從範本新增檔案">
                    <MenuFlyoutItem Text="C# 程式檔 (.cs)" Click="MenuNewCSharp_Click" />
                    <MenuFlyoutItem Text="Python 腳本 (.py)" Click="MenuNewPython_Click" />
                    <MenuFlyoutItem Text="HTML5 網頁 (.html)" Click="MenuNewHtml_Click" />
                    <MenuFlyoutItem Text="JSON 設定檔 (.json)" Click="MenuNewJson_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="開啟檔案..." Icon="OpenFile" Click="MenuOpenFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="開啟資料夾..." Icon="Folder" Click="MenuOpenFolder_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="儲存" Icon="Save" Click="BtnSave_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="另存新檔..." Icon="SaveLocal" Click="MenuSaveAs_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="關閉分頁" Click="MenuCloseTab_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="結束" Click="MenuExit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="編輯(E)">
                <MenuFlyoutItem Text="格式化文件" Click="MenuFormatDocument_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Shift,Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="尋找..." Click="MenuFind_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="在專案中尋找..." Click="MenuFindInFiles_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="放大字型" Click="MenuZoomIn_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Add" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="縮小字型" Click="MenuZoomOut_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Subtract" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="檢視(V)">
                <ToggleMenuFlyoutItem Text="側邊欄 (Explorer)" IsChecked="{x:Bind ViewModel.IsSidebarOpen, Mode=TwoWay}" Click="BtnToggleSidebar_Click" />
                <ToggleMenuFlyoutItem Text="下方輸出/終端機" IsChecked="{x:Bind ViewModel.IsBottomPanelOpen, Mode=TwoWay}" Click="BtnToggleBottomPanel_Click" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="程式碼縮圖 (Minimap)" IsChecked="{x:Bind ViewModel.ShowMinimap, Mode=TwoWay}" Click="MenuToggleMinimap_Click" />
                <ToggleMenuFlyoutItem Text="自動換行 (Word Wrap)" IsChecked="{x:Bind ViewModel.WordWrap, Mode=TwoWay}" Click="MenuToggleWordWrap_Click" />
            </MenuBarItem>

            <MenuBarItem Title="執行(R)">
                <MenuFlyoutItem Text="執行目前檔案 (F5)" Icon="Play" Click="BtnQuickRun_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="終止執行 (Shift+F5)" Icon="Stop" Click="BtnQuickStop_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" Modifiers="Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="清除輸出記錄" Click="MenuClearOutput_Click" />
            </MenuBarItem>

            <MenuBarItem Title="說明(H)">
                <MenuFlyoutItem Text="關於 AetherIDE" Click="MenuAbout_Click" />
                <MenuFlyoutItem Text="快速鍵一覽" Click="MenuShortcuts_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- 3. Main Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />   <!-- Activity Bar -->
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500" x:Name="SidebarColumn" /> <!-- Sidebar -->
                <ColumnDefinition Width="4" />    <!-- Splitter -->
                <ColumnDefinition Width="*" />    <!-- Main Editor & Bottom Area -->
            </Grid.ColumnDefinitions>

            <!-- Activity Bar (VS Code style vertical strip) -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Icons -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4" Margin="0,8,0,0">
                    <!-- Explorer -->
                    <Button x:Name="BtnNavExplorer"
                            ToolTipService.ToolTip="檔案總管"
                            Click="BtnNavExplorer_Click"
                            Width="40" Height="40"
                            Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Button>

                    <!-- Search -->
                    <Button x:Name="BtnNavSearch"
                            ToolTipService.ToolTip="搜尋 (Ctrl+Shift+F)"
                            Click="BtnNavSearch_Click"
                            Width="40" Height="40"
                            Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE721;" FontSize="18" />
                    </Button>

                    <!-- Aether AI Assistant -->
                    <Button x:Name="BtnNavAi"
                            ToolTipService.ToolTip="Aether AI 智慧助理"
                            Click="BtnNavAi_Click"
                            Width="40" Height="40"
                            Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="#A855F7" />
                    </Button>

                    <!-- Code Snippets -->
                    <Button x:Name="BtnNavSnippets"
                            ToolTipService.ToolTip="程式碼範本庫"
                            Click="BtnNavSnippets_Click"
                            Width="40" Height="40"
                            Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xEA86;" FontSize="18" />
                    </Button>

                    <!-- Run & Debug -->
                    <Button x:Name="BtnNavRun"
                            ToolTipService.ToolTip="執行與除錯環境"
                            Click="BtnNavRun_Click"
                            Width="40" Height="40"
                            Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE768;" FontSize="18" />
                    </Button>

                    <!-- Settings -->
                    <Button x:Name="BtnNavSettings"
                            ToolTipService.ToolTip="偏好設定"
                            Click="BtnNavSettings_Click"
                            Width="40" Height="40"
                            Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE713;" FontSize="18" />
                    </Button>
                </StackPanel>

                <!-- Bottom Profile / Theme -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,8" Spacing="4">
                    <Button ToolTipService.ToolTip="主題切換" Click="BtnThemeToggle_Click"
                            Width="40" Height="40" Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE708;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Sidebar Panel -->
            <Grid Grid.Column="1"
                  Visibility="{x:Bind BoolToVisibility(ViewModel.IsSidebarOpen), Mode=OneWay}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Grid Grid.Row="0" Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SidebarTitleText" Text="檔案總管" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />

                    <!-- Header Actions (Visible in Explorer mode) -->
                    <StackPanel x:Name="ExplorerHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button ToolTipService.ToolTip="新增檔案" Click="MenuNewFile_Click" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                        <Button ToolTipService.ToolTip="開啟資料夾" Click="MenuOpenFolder_Click" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE838;" FontSize="12" />
                        </Button>
                        <Button ToolTipService.ToolTip="重新整理" Click="BtnRefreshWorkspace_Click" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sidebar Content Views -->
                <Grid Grid.Row="1">
                    <!-- 1. Explorer View -->
                    <Grid x:Name="ViewExplorer" Visibility="Visible">
                        <TreeView x:Name="WorkspaceTreeView"
                                  ItemsSource="{x:Bind ViewModel.WorkspaceFiles, Mode=OneWay}"
                                  ItemInvoked="WorkspaceTreeView_ItemInvoked"
                                  SelectionMode="Single"
                                  Padding="4">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                        <TreeViewItem.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="開啟檔案" Click="TreeItemOpen_Click" Tag="{x:Bind}" />
                                                <MenuFlyoutItem Text="在檔案總管中顯示" Click="TreeItemReveal_Click" Tag="{x:Bind}" />
                                                <MenuFlyoutItem Text="複製完整路徑" Click="TreeItemCopyPath_Click" Tag="{x:Bind}" />
                                            </MenuFlyout>
                                        </TreeViewItem.ContextFlyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,3">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{x:Bind IconColor}" />
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Empty State if no folder opened -->
                        <StackPanel x:Name="EmptyWorkspacePanel"
                                    Visibility="{x:Bind InverseBoolToVisibility(ViewModel.WorkspaceFiles.Count), Mode=OneWay}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="16">
                            <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="尚未開啟任何專案資料夾" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                            <Button Content="開啟資料夾..." Style="{ThemeResource AccentButtonStyle}" Click="MenuOpenFolder_Click" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 2. Search View -->
                    <Grid x:Name="ViewSearch" Visibility="Collapsed" Margin="12,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="在檔案中搜尋..." KeyDown="SearchBox_KeyDown" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8">
                            <ToggleButton Content="Aa" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" ToolTipService.ToolTip="大小寫須相符" Padding="8,4" />
                            <ToggleButton Content="\b" IsChecked="{x:Bind ViewModel.MatchWholeWord, Mode=TwoWay}" ToolTipService.ToolTip="符合整字" Padding="8,4" />
                            <Button Content="搜尋" Style="{ThemeResource AccentButtonStyle}" Click="BtnExecuteSearch_Click" Padding="12,4" />
                        </StackPanel>

                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}" SelectionChanged="SearchResults_SelectionChanged" Margin="0,4,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchResultItem">
                                    <StackPanel Padding="4,6" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind LineNumber, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind LineContent}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 3. Aether AI Assistant View -->
                    <Grid x:Name="ViewAi" Visibility="Collapsed" Margin="12,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Quick Prompts Wrap/Stack -->
                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                            <TextBlock Text="Aether AI 智慧指令" FontSize="12" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="💡 解釋程式碼" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" Click="BtnAiExplain_Click" />
                                <Button Grid.Row="0" Grid.Column="1" Content="🔍 尋找 Bug" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" Click="BtnAiFindBugs_Click" />
                                <Button Grid.Row="1" Grid.Column="0" Content="⚡ 效能最佳化" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" Click="BtnAiOptimize_Click" />
                                <Button Grid.Row="1" Grid.Column="1" Content="🧪 產生測試" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" Click="BtnAiGenerateTest_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- Response Viewer -->
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind BoolToVisibility(ViewModel.IsAiProcessing), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI, Cascadia Code" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Prompt Input -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AiInputBox" PlaceholderText="詢問 Aether AI..." Text="{x:Bind ViewModel.AiPrompt, Mode=TwoWay}" KeyDown="AiInputBox_KeyDown" />
                            <Button Grid.Column="1" Content="發問" Style="{ThemeResource AccentButtonStyle}" Click="BtnAiSend_Click" Margin="6,0,0,0" />
                        </Grid>
                    </Grid>

                    <!-- 4. Code Snippets & Templates View -->
                    <Grid x:Name="ViewSnippets" Visibility="Collapsed" Margin="12,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="點擊即可將範本直接插入目前游標處" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Snippets, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:SnippetItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,3">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" />
                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="4,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{x:Bind Language}" FontSize="10" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Button Content="插入到編輯器" Style="{ThemeResource AccentButtonStyle}" Padding="8,3" FontSize="11" Click="BtnInsertSnippet_Click" Tag="{x:Bind}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 5. Run & Tools View -->
                    <Grid x:Name="ViewRun" Visibility="Collapsed" Margin="12">
                        <StackPanel Spacing="16">
                            <TextBlock Text="執行與除錯環境" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="AetherIDE 自動調用系統中的直譯器與編譯器：" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <StackPanel Spacing="8">
                                <Button Content="▶ 執行 Python (.py)" HorizontalAlignment="Stretch" Click="BtnRunPython_Click" />
                                <Button Content="▶ 執行 Node.js (.js/.ts)" HorizontalAlignment="Stretch" Click="BtnRunNode_Click" />
                                <Button Content="▶ 執行 .NET (dotnet run)" HorizontalAlignment="Stretch" Click="BtnRunDotnet_Click" />
                                <Button Content="▶ 執行 PowerShell 腳本" HorizontalAlignment="Stretch" Click="BtnRunPowerShell_Click" />
                            </StackPanel>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="目前執行檔案：" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTab.Title, Mode=OneWay, FallbackValue='無'}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="語言類型：" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 6. Settings View -->
                    <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" Padding="12">
                        <StackPanel Spacing="16">
                            <TextBlock Text="偏好設定" FontWeight="SemiBold" FontSize="14" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="色彩外觀" FontSize="13" FontWeight="SemiBold" />
                                <RadioButtons SelectedIndex="0" SelectionChanged="RadioTheme_SelectionChanged">
                                    <RadioButton Content="深色主題 (VS Dark)" Tag="Dark" IsChecked="True" />
                                    <RadioButton Content="淺色主題 (VS Light)" Tag="Light" />
                                </RadioButtons>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <TextBlock Text="字型大小" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.FontSize, Mode=OneWay}" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Slider Minimum="10" Maximum="26" Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}" ValueChanged="SliderFontSize_ValueChanged" />
                            </StackPanel>

                            <ToggleSwitch Header="程式碼縮圖 (Minimap)" IsOn="{x:Bind ViewModel.ShowMinimap, Mode=TwoWay}" Toggled="ToggleMinimap_Toggled" />

                            <ToggleSwitch Header="自動換行 (Word Wrap)" IsOn="{x:Bind ViewModel.WordWrap, Mode=TwoWay}" Toggled="ToggleWordWrap_Toggled" />

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="AetherIDE v1.0.0" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="為 Windows 平台量身打造的高效能現代 WinUI 3 程式 IDE。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Column Splitter between Sidebar and Editor -->
            <sizers:GridSplitter Grid.Column="2"
                                 Width="4"
                                 HorizontalAlignment="Center"
                                 ResizeBehavior="BasedOnAlignment"
                                 ResizeDirection="Columns"
                                 Background="Transparent"
                                 Cursor="SizeWestEast" />

            <!-- Main Editor and Bottom Area -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" x:Name="EditorRow" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="220" MinHeight="100" MaxHeight="600" x:Name="BottomPanelRow" />
                </Grid.RowDefinitions>

                <!-- Row 0: Editor TabView + Monaco / Welcome Screen -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Modern TabView for Open Files -->
                    <TabView x:Name="EditorTabView"
                             Grid.Row="0"
                             TabItemsSource="{x:Bind ViewModel.OpenTabs, Mode=OneWay}"
                             SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                             AddTabButtonClick="EditorTabView_AddTabButtonClick"
                             TabCloseRequested="EditorTabView_TabCloseRequested"
                             SelectionChanged="EditorTabView_SelectionChanged"
                             CanReorderTabs="True"
                             CanDragTabs="True">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="models:EditorTabItem">
                                <TabViewItem Header="{x:Bind DisplayTitle, Mode=OneWay}">
                                    <TabViewItem.IconSource>
                                        <FontIconSource Glyph="{x:Bind IconGlyph}" Foreground="{x:Bind IconColor}" />
                                    </TabViewItem.IconSource>
                                    <TabViewItem.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="儲存 (Ctrl+S)" Click="TabMenuSave_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="關閉分頁 (Ctrl+W)" Click="TabMenuClose_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="關閉其他分頁" Click="TabMenuCloseOthers_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="在檔案總管中顯示" Click="TabMenuReveal_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="複製完整路徑" Click="TabMenuCopyPath_Click" Tag="{x:Bind}" />
                                        </MenuFlyout>
                                    </TabViewItem.ContextFlyout>
                                </TabViewItem>
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>

                    <!-- Center Area: Monaco WebView2 or Welcome Screen -->
                    <Grid Grid.Row="1">
                        <!-- Monaco Code Editor Host (Visible when tabs exist) -->
                        <WebView2 x:Name="EditorWebView"
                                  Visibility="{x:Bind BoolToVisibility(ViewModel.HasOpenTabs), Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />

                        <!-- Welcome Screen (Visible when NO tabs are open) -->
                        <Grid x:Name="WelcomeScreen"
                              Visibility="{x:Bind InverseBoolToVisibility(ViewModel.HasOpenTabs), Mode=OneWay}"
                              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="24" Spacing="24">
                                    <!-- Hero Header -->
                                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Width="56" Height="56" CornerRadius="14">
                                            <FontIcon Glyph="&#xE943;" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="AetherIDE" FontSize="28" FontWeight="Bold" />
                                            <TextBlock Text="現代化 Windows 原生高效能程式碼整合開發環境" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quick Actions Cards -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- New File Card -->
                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14" Click="MenuNewFile_Click" CornerRadius="8">
                                            <StackPanel Spacing="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                                                <TextBlock Text="新增檔案" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="建立空白或範本檔案" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Open File Card -->
                                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14" Click="MenuOpenFile_Click" CornerRadius="8">
                                            <StackPanel Spacing="8">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                                                <TextBlock Text="開啟檔案" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="載入程式原始碼檔案" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Open Folder Card -->
                                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14" Click="MenuOpenFolder_Click" CornerRadius="8">
                                            <StackPanel Spacing="8">
                                                <FontIcon Glyph="&#xE838;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                                                <TextBlock Text="開啟專案目錄" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="載入工作區檔案總管" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Keyboard Shortcuts Guide Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="常用快速鍵指引" FontWeight="SemiBold" FontSize="14" />
                                            <Grid ColumnSpacing="16" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="• F5：直接執行目前檔案" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="• Ctrl + S：儲存檔案" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="• Shift + Alt + F：格式化文件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="• Ctrl + `：切換輸出終端機" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="• Ctrl + Shift + F：全域搜尋" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="• Ctrl + N / O：新增/開啟檔案" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="• Ctrl + P：快速搜尋或命令" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="• Shift + F5：停止執行程式" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Row 1: Splitter between Editor and Bottom Panel -->
                <sizers:GridSplitter Grid.Row="1"
                                     Height="4"
                                     VerticalAlignment="Center"
                                     ResizeBehavior="BasedOnAlignment"
                                     ResizeDirection="Rows"
                                     Background="Transparent"
                                     Cursor="SizeNorthSouth" />

                <!-- Row 2: Bottom Panel (Output, Terminal, Problems) -->
                <Grid Grid.Row="2"
                      Visibility="{x:Bind BoolToVisibility(ViewModel.IsBottomPanelOpen), Mode=OneWay}"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Bottom Panel Header Tabs & Actions -->
                    <Grid Grid.Row="0" Margin="12,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Tab Selection Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="BtnTabOutput" Content="輸出 (Output)" Click="BtnTabOutput_Click" Padding="10,4" CornerRadius="4" FontWeight="SemiBold" FontSize="12" />
                            <Button x:Name="BtnTabTerminal" Content="終端機 (PowerShell)" Click="BtnTabTerminal_Click" Padding="10,4" CornerRadius="4" FontSize="12" />
                            <Button x:Name="BtnTabProblems" Click="BtnTabProblems_Click" Padding="10,4" CornerRadius="4" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="問題 (Problems)" />
                                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="10" Padding="6,1" Visibility="{x:Bind BoolToVisibility(ViewModel.ProblemCount), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.ProblemCount, Mode=OneWay}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button ToolTipService.ToolTip="清除輸出" Click="MenuClearOutput_Click" Padding="6,4" CornerRadius="4" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE75C;" FontSize="13" />
                            </Button>
                            <Button ToolTipService.ToolTip="關閉面板" Click="BtnToggleBottomPanel_Click" Padding="6,4" CornerRadius="4" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Panel Content -->
                    <Grid Grid.Row="1">
                        <!-- 1. Output Log Tab -->
                        <TextBox x:Name="OutputTextBox"
                                 Visibility="Visible"
                                 Text="{x:Bind ViewModel.OutputLog, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,6" />

                        <!-- 2. Terminal Tab -->
                        <Grid x:Name="TerminalTabGrid" Visibility="Collapsed" Margin="8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox Text="{x:Bind ViewModel.OutputLog, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0" />

                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TerminalInputBox"
                                         PlaceholderText="輸入命令 (例如: dotnet --version, python --version, dir)..."
                                         KeyDown="TerminalInputBox_KeyDown"
                                         Text="{x:Bind ViewModel.TerminalInput, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="發送" Style="{ThemeResource AccentButtonStyle}" Click="BtnSendTerminal_Click" Margin="6,0,0,0" />
                            </Grid>
                        </Grid>

                        <!-- 3. Problems Tab -->
                        <ListView x:Name="ProblemsListView"
                                  Visibility="Collapsed"
                                  ItemsSource="{x:Bind ViewModel.Problems, Mode=OneWay}"
                                  Padding="8">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProblemItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                        <FontIcon Glyph="{x:Bind SeverityGlyph}" Foreground="{x:Bind SeverityColor}" FontSize="14" />
                                        <TextBlock Text="{x:Bind Message}" FontSize="12" />
                                        <TextBlock Text="{x:Bind FilePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Left: Git branch & Progress & Status message -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8CD;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="main" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsProcessRunning, Mode=OneWay}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsProcessRunning), Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status Right: Ln/Col, Indent, Encoding, Language -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                <!-- Line and Column -->
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="第 " /><Run Text="{x:Bind ViewModel.CurrentLine, Mode=OneWay}" /><Run Text=" 列，第 " /><Run Text="{x:Bind ViewModel.CurrentColumn, Mode=OneWay}" /><Run Text=" 欄" />
                </TextBlock>

                <!-- Indentation -->
                <TextBlock Text="{x:Bind ViewModel.CurrentIndentation, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Encoding -->
                <TextBlock Text="{x:Bind ViewModel.CurrentEncoding, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Language Mode Button with Flyout -->
                <DropDownButton Padding="6,2" CornerRadius="4" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="C# (csharp)" Click="LanguageItem_Click" Tag="csharp" />
                            <MenuFlyoutItem Text="Python (python)" Click="LanguageItem_Click" Tag="python" />
                            <MenuFlyoutItem Text="JavaScript (javascript)" Click="LanguageItem_Click" Tag="javascript" />
                            <MenuFlyoutItem Text="TypeScript (typescript)" Click="LanguageItem_Click" Tag="typescript" />
                            <MenuFlyoutItem Text="HTML (html)" Click="LanguageItem_Click" Tag="html" />
                            <MenuFlyoutItem Text="CSS (css)" Click="LanguageItem_Click" Tag="css" />
                            <MenuFlyoutItem Text="JSON (json)" Click="LanguageItem_Click" Tag="json" />
                            <MenuFlyoutItem Text="Markdown (markdown)" Click="LanguageItem_Click" Tag="markdown" />
                            <MenuFlyoutItem Text="C/C++ (cpp)" Click="LanguageItem_Click" Tag="cpp" />
                            <MenuFlyoutItem Text="SQL (sql)" Click="LanguageItem_Click" Tag="sql" />
                            <MenuFlyoutItem Text="PowerShell (powershell)" Click="LanguageItem_Click" Tag="powershell" />
                            <MenuFlyoutItem Text="純文字 (plaintext)" Click="LanguageItem_Click" Tag="plaintext" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

